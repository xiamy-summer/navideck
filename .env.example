# 数据目录（SQLite 与上传文件存放位置，Docker 中建议 /data）
DATA_DIR=.data

# JWT 签名密钥，生产环境务必修改
JWT_SECRET=please-change-this-secret

# 首次启动自动创建管理员 admin 的初始密码
DEFAULT_ADMIN_PASSWORD=admin123

# 图标服务地址（Iconify API），离线或访问慢时可替换为自建服务
NEXT_PUBLIC_ICONIFY_API=https://api.iconify.design

# 服务端口
PORT=3000

# ---------------------- OIDC 单点登录（可选） ----------------------
# 设为 true 启用；不配置则登录页只显示账号密码
OIDC_ENABLED=false
# 签发方（Issuer），会自动拼接 /.well-known/openid-configuration
OIDC_ISSUER=https://your-idp.example.com/realms/master
# 在 IdP 注册的客户端 ID / Secret（回调地址需填 http(s)://<本应用域名>/api/auth/oidc/callback）
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 可选：覆盖回调地址（默认按请求来源自动推断）；若反代/非标准域名建议显式填写
OIDC_REDIRECT_URI=
# 可选：授权范围（默认 openid email profile）
OIDC_SCOPES=openid email profile
# 可选：首次通过 OIDC 登录自动建档的默认角色（user 或 admin）
OIDC_DEFAULT_ROLE=user
# 可选：管理员判定 —— 当该 claim 的值等于指定值时授予 admin（如 groups / role）
OIDC_ADMIN_CLAIM=
OIDC_ADMIN_VALUE=
# 可选：登录页按钮文案
OIDC_BUTTON_LABEL=单点登录

